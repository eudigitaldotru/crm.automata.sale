# ============================================================
# TG-GATEWAY .env — СКОПИРУЙТЕ В .env И ЗАПОЛНИТЕ
# ============================================================

# --- Telegram API (получить на https://my.telegram.org → API development tools) ---
TG_API_ID=123456
TG_API_HASH=вставьте_ваш_api_hash

# --- Авторизация gateway ---
# Токен, которым локальная CRM и userbot авторизуются на gateway.
# Сгенерируйте случайный: openssl rand -hex 32
GATEWAY_TOKEN=сгенерируйте_длинный_случайный_токен

# --- Порт gateway (слушает на VPS) ---
# CRM будет обращаться к https://VPS_IP:8443 — порт 8443 проходит белые списки.
# Для production поставьте за nginx с TLS на 443.
GATEWAY_PORT=8443
GATEWAY_DB=gateway.db

# --- Userbot ---
TG_SESSION=gateway_session
GATEWAY_URL=http://localhost:8443
USERBOT_CHANNEL_ID=1
