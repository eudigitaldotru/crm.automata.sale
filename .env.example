# ============================================================
# Automata CRM — .env  (СКОПИРУЙТЕ В .env И ЗАПОЛНИТЕ НУЖНОЕ)
# Всё необязательно: без заполнения работает локальный минимум.
# ============================================================

# --- Кто вы (подставляется в договоры, счета, подписи, шаблоны) ---
CRM_OWNER_NAME=Иван Иванов
CRM_OWNER_TITLE=Ваша подпись / специализация
CRM_OWNER_PHONE=+7 (000) 000-00-00
CRM_OWNER_TELEGRAM=@your_handle
CRM_OWNER_EMAIL=you@example.com
CRM_OWNER_SITE=example.com
CRM_OWNER_LEGAL=ИП Иванов Иван Иванович, ИНН 000000000000
CRM_BOT_NAME=Automata CRM assist

# --- Исходящая почта (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=crm@example.com
SMTP_PASS=

# --- Входящая почта (IMAP, можно несколько через scripts/mailboxes.json) ---
EMAIL_IMAP_HOST=imap.example.com
EMAIL_USER=crm@example.com
EMAIL_PASS=
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587

# --- Telegram-шлюз (см. tg-gateway/.env.example) ---
TG_GATEWAY_URL=http://your-vps-ip:8443
TG_GATEWAY_TOKEN=

# --- Telegram-бот (уведомления/команды) ---
TELEGRAM_BOT_TOKEN=
BOT_TOKEN=
API_ID=
API_HASH=
ADMIN_TG_ID=
MY_USER_ID=

# --- MAX-мессенджер ---
MAX_BOT_TOKEN=

# --- Опционально: push на мобильный хаб ---
HUB_URL=
HUB_TOKEN=

# --- Опционально: внешний мониторинг по SSH ---
MONITOR_VPS_HOST=
TG_GATEWAY_VPS_HOST=
TG_GATEWAY_VPS_PORT=22

# --- Опционально: health-check сайта в дашборде ---
CRM_SAMPLE_SITE=https://example.com/

# --- Опционально: голосовой UI / LLM ---
GLM_API_KEY=
GLM_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
EDGE_TTS_VOICE=

# --- Прочее ---
SAFE_BROWSING_KEY=
RESEND_API_KEY=
SERVER_URL=
SYNC_SECRET=
